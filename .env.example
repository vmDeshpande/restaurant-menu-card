# MongoDB Atlas or another MongoDB deployment. Keep both values server-only.
MONGODB_URI=
MONGODB_DB_NAME=

# Session
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=restaurant_session

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Optional: source file used only by the one-time SQLite import command.
SQLITE_SOURCE_PATH=./data/restaurant.db
